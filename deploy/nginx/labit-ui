server {
    server_name labit.sdrc.in;

    client_max_body_size 50m;

    # Machine middleware boundary. Only these two paths are forwarded to
    # Labit Core; the browser UI and every other Core route remain separate.
    location ~ ^/machine-api/orders/([^/]+)$ {
        limit_except GET { deny all; }
        rewrite ^/machine-api/orders/(.*)$ /api/framework/machine_order_lookup?barcode=$1 break;
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Api-Key-Id $http_x_api_key_id;
        proxy_set_header X-Api-Secret $http_x_api_secret;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location = /machine-api/inbox {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8001/api/framework/machine_result_ingest;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Api-Key-Id $http_x_api_key_id;
        proxy_set_header X-Api-Secret $http_x_api_secret;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location = /machine-api/qc {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8001/api/framework/machine_qc_ingest;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Api-Key-Id $http_x_api_key_id;
        proxy_set_header X-Api-Secret $http_x_api_secret;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/labit.sdrc.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/labit.sdrc.in/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = labit.sdrc.in) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    server_name labit.sdrc.in;
    return 404;
}
